{
  "$defs": {
    "Artifact": {
      "description": "An immutable, content-addressed artifact (§6.1).\n\nThe digest identifies immutable bytes. Every acquisition keeps its own exact receipt,\nincluding source locator and retrieval time, in the native Delta catalog. Evidence resolves\nprovenance through its selected attempt; byte delivery resolves the complete digest.",
      "properties": {
        "artifact_id": {
          "description": "`art_<64 hex>`, derived from the complete digest; used by `read_artifact`.",
          "type": "string"
        },
        "compression": {
          "description": "Transport compression that was removed before storage, e.g. `zstd`.",
          "type": [
            "string",
            "null"
          ]
        },
        "etag": {
          "description": "HTTP validator, when the server supplied one.",
          "type": [
            "string",
            "null"
          ]
        },
        "final_url": {
          "description": "Where it was actually served from after redirects, when different.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "What the artifact is.",
          "enum": [
            "registry_index_entry",
            "registry_version_metadata",
            "crate_tarball",
            "rustdoc_json",
            "cargo_manifest",
            "readme",
            "changelog",
            "source_file",
            "other"
          ],
          "type": "string"
        },
        "last_modified": {
          "description": "HTTP validator, when the server supplied one.",
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "description": "Media type of the stored bytes (after any transport decompression).",
          "type": "string"
        },
        "retrieved_at": {
          "description": "When it was retrieved, RFC 3339. Provenance only; never part of any identity.",
          "type": "string"
        },
        "sha256": {
          "description": "Full SHA-256 of the stored bytes, lower-case hex.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Size of the stored bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_uri": {
          "description": "Where it was requested from.",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "size_bytes",
        "kind",
        "source_uri",
        "final_url",
        "retrieved_at",
        "etag",
        "last_modified",
        "compression"
      ],
      "type": "object"
    },
    "ArtifactHandle": {
      "additionalProperties": false,
      "description": "A pointer to a bounded, readable artifact.",
      "properties": {
        "description": {
          "description": "What the artifact contains, so a caller can decide whether to read it.",
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/Artifact",
          "description": "Exact content identity and this acquisition's provenance. Pass receipt.artifact_id\nto read_artifact; repeated bytes may have different acquisition receipts."
        },
        "uri": {
          "description": "Always a `library-evidence://` URI -- enforced by [`ArtifactUri`], not only by the schema.",
          "pattern": "^library-evidence://",
          "type": "string"
        }
      },
      "required": [
        "receipt",
        "uri",
        "description"
      ],
      "type": "object"
    },
    "ArtifactSection": {
      "description": "A result projection is distinct from a Markdown heading selection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string"
            },
            "kind": {
              "const": "markdown",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "result",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/ResultSectionName"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What was actually looked at, and what was not.\n\n`ok` means successful within this scope, never complete knowledge of a library. An empty\n`search_evidence` result with `indexed: [\"public_api\"]` is a valid negative answer; the same\nresult with `missing: [\"public_api\"]` is an evidence gap. The two must never collapse.",
      "properties": {
        "assessments": {
          "description": "Requested evidence scopes assessed against qualified native facts.",
          "items": {
            "$ref": "#/$defs/ScopeAssessment"
          },
          "type": "array"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When present, additional limitation text is retained in the exact coverage section.\nScope, assessments, indexed and missing remain the authoritative inline assessment."
        },
        "indexed": {
          "description": "Evidence kinds that were successfully indexed.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "limitations": {
          "description": "Known reasons this result may not generalize.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "missing": {
          "description": "Evidence kinds that were expected but are absent.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "description": "What the result claims to cover, in prose.",
          "type": "string"
        }
      },
      "required": [
        "details",
        "assessments",
        "scope",
        "indexed",
        "missing",
        "limitations"
      ],
      "type": "object"
    },
    "DeliveryDescriptor": {
      "description": "Delivery changes representation, never the original research status or coverage.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "limits": {
              "$ref": "#/$defs/DeliveryLimits"
            },
            "mode": {
              "const": "inline",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "limits"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/DeliveryLimits"
            },
            "mode": {
              "const": "artifact",
              "type": "string"
            },
            "read": {
              "$ref": "#/$defs/RecoveryAction"
            },
            "sections": {
              "items": {
                "$ref": "#/$defs/ResultSection"
              },
              "type": "array"
            }
          },
          "required": [
            "mode",
            "artifact_id",
            "sections",
            "read",
            "limits"
          ],
          "type": "object"
        }
      ]
    },
    "DeliveryLimits": {
      "additionalProperties": false,
      "description": "Actual envelope budget, distinct from MCP framing overhead.",
      "properties": {
        "effective_max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requested_max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "requested_max_bytes",
        "effective_max_bytes"
      ],
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "Structured failure evidence, authored where the cause is known.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/RecoveryAction"
          },
          "type": "array"
        },
        "affected_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cause": {
          "$ref": "#/$defs/DiagnosticCause"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "cause",
        "stage",
        "affected_ids",
        "rule",
        "observed",
        "allowed",
        "correlation_id",
        "actions"
      ],
      "type": "object"
    },
    "DiagnosticCause": {
      "description": "Origin classification, separate from stable public error categories.",
      "enum": [
        "invalid_input",
        "not_found",
        "permission_denied",
        "corrupt_state",
        "io",
        "capacity",
        "deadline",
        "invalid_plan",
        "policy_denied",
        "unsupported",
        "upstream",
        "transport",
        "internal"
      ],
      "type": "string"
    },
    "Error": {
      "additionalProperties": false,
      "description": "A typed failure with a concrete next action.\n\nEmitted into `$defs` as `Error`; the Rust name avoids colliding with `std::error::Error` at\nevery use site. Renaming this type, or dropping the `rename`, leaves a dangling `$ref` in\nthe root conditionals -- `wire_conformance::every_ref_in_the_schema_resolves` catches that.",
      "properties": {
        "code": {
          "description": "The stable code a caller can branch on.",
          "enum": [
            "VERSION_NOT_FOUND",
            "AMBIGUOUS_PACKAGE",
            "ARTIFACT_UNAVAILABLE",
            "UNSUPPORTED_FORMAT",
            "ENVIRONMENT_UNRESOLVED",
            "ENVIRONMENT_MISMATCH",
            "POLICY_DENIED",
            "UNSUPPORTED_CAPABILITY",
            "UPSTREAM_UNAVAILABLE",
            "EXTRACTION_FAILED",
            "VERIFICATION_FAILED",
            "BUDGET_EXCEEDED",
            "INVALID_CURSOR",
            "QUERY_FAILED",
            "INTERNAL_ERROR"
          ],
          "type": "string"
        },
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic",
          "description": "Structured origin and recovery evidence."
        },
        "message": {
          "description": "Human-readable explanation. Not a stable interface.",
          "type": "string"
        },
        "next_action": {
          "description": "What the caller should do instead. Blueprint §7.2 requires this, not just a code.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether retrying the identical request could succeed.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "next_action",
        "diagnostic"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One supporting fact, with the provenance needed to check it.\n\nBlueprint §7.2: every entry carries an ID, class, subject, exact locator, source-version\nmatch and producer, plus a compact excerpt -- not an unexplained numeric confidence.",
      "properties": {
        "artifact_id": {
          "description": "The artifact this was read out of.",
          "type": "string"
        },
        "evidence_class": {
          "description": "Which epistemic class this fact belongs to.",
          "enum": [
            "declared",
            "statically_extracted",
            "compiler_derived",
            "typechecker_observed",
            "runtime_observed",
            "agent_inferred"
          ],
          "type": "string"
        },
        "evidence_id": {
          "description": "Stable handle for citation.",
          "type": "string"
        },
        "excerpt": {
          "description": "A compact supporting quote.",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "description": "Position within the artifact. Specialized as a discriminated union per producer.",
          "type": "object"
        },
        "producer": {
          "description": "Which producer emitted this.",
          "type": "string"
        },
        "producer_version": {
          "description": "The exact producer version, for reproducibility.",
          "type": "string"
        },
        "source_uri": {
          "description": "Where the artifact came from.",
          "format": "uri",
          "type": "string"
        },
        "source_version_match": {
          "description": "How the source's version relates to the requested one.",
          "enum": [
            "exact",
            "compatible_claimed",
            "mismatched",
            "unknown"
          ],
          "type": "string"
        },
        "subject": {
          "description": "What the fact is about -- a symbol path, a setting, a release.",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_class",
        "subject",
        "artifact_id",
        "source_uri",
        "locator",
        "source_version_match",
        "producer",
        "producer_version",
        "excerpt"
      ],
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "description": "Registry freshness. Blueprint §3.3: freshness is not one timestamp.",
      "properties": {
        "latest_verified": {
          "description": "Whether \"this is the latest release\" was actually revalidated. A cache hit alone is not\nevidence that a release is still latest.",
          "type": "boolean"
        },
        "registry_checked_at": {
          "description": "When the registry was last consulted, or `null` if it was not consulted at all.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "source_version_match": {
          "description": "How the evidence's source version relates to the requested one.",
          "enum": [
            "exact",
            "compatible_claimed",
            "mismatched",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "registry_checked_at",
        "source_version_match",
        "latest_verified"
      ],
      "type": "object"
    },
    "JobHandle": {
      "additionalProperties": false,
      "description": "A receipt for submitted work. Never evidence that the work finished.",
      "properties": {
        "job_id": {
          "description": "Durable core job identity. Distinct from the request ID: jobs are shared and reusable.",
          "type": "string"
        },
        "poll_after_ms": {
          "description": "Advisory next-poll delay. Not a completion-time guarantee.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stage": {
          "description": "Which stage is executing, for a caller to report progress.",
          "type": "string"
        },
        "state": {
          "description": "Where the job is now.",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "partial",
            "failed",
            "cancel_requested",
            "cancelled"
          ],
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "state",
        "stage",
        "poll_after_ms"
      ],
      "type": "object"
    },
    "RecoveryAction": {
      "description": "An actionable follow-up, never an instruction to execute automatically.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "additionalProperties": true,
              "type": "object"
            },
            "kind": {
              "const": "call_tool",
              "type": "string"
            },
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tool",
            "arguments"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "read_artifact",
              "type": "string"
            },
            "section": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactSection"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "artifact_id",
            "section",
            "cursor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "retry_after",
              "type": "string"
            },
            "milliseconds": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "milliseconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "change_request",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "operator_setup",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "report_defect",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ResultSection": {
      "additionalProperties": false,
      "description": "Named typed section of an immutable research result.",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/ResultSectionName"
        }
      },
      "required": [
        "name",
        "artifact_id"
      ],
      "type": "object"
    },
    "ResultSectionName": {
      "description": "Stable directly readable projections in an indexed research result.",
      "enum": [
        "coverage",
        "signature",
        "changes",
        "aspects",
        "data"
      ],
      "type": "string"
    },
    "ScopeAssessment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "The kinds of evidence a producer can require or yield, and that `coverage.indexed` and\n`coverage.missing` name.\n\nThe values are, in order: `registry_metadata`, `crate_source`,\n`documentation_build_config`, `hosted_rustdoc_json`, `public_api`, `documentation`,\n`examples`, `release_notes`, `source_excerpts`.",
          "enum": [
            "registry_metadata",
            "crate_source",
            "documentation_build_config",
            "hosted_rustdoc_json",
            "public_api",
            "documentation",
            "examples",
            "release_notes",
            "source_excerpts",
            "distribution_source",
            "stubs",
            "inventory",
            "runtime_api",
            "semantic_queries",
            "usage_probes"
          ],
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ScopeState"
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "witness_id": {
          "description": "A qualified fact establishing the selected state. Historical attempts remain retained.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "snapshot_id",
        "subject",
        "kind",
        "state",
        "witness_id"
      ],
      "type": "object"
    },
    "ScopeState": {
      "description": "Unknown means no qualified coverage fact exists; it is distinct from a declared gap.",
      "enum": [
        "indexed",
        "partial",
        "missing",
        "unknown"
      ],
      "type": "string"
    },
    "SubjectRef": {
      "description": "A reference carries its indexing domain. External paths never masquerade as local keys.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            },
            "symbol_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "symbol_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "definition_id": {
              "type": "string"
            },
            "kind": {
              "const": "definition",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "definition_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "library",
              "type": "string"
            },
            "release_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "release_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "feature",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "heading": {
              "type": "string"
            },
            "kind": {
              "const": "document",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_id",
            "heading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "kind": {
              "const": "example",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_id",
            "path"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "inline"
              }
            }
          },
          "error": {
            "type": "null"
          },
          "job": {
            "$ref": "#/$defs/JobHandle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/Error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "mode": {
                "const": "artifact"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "description": "The response envelope every tool returns.\n\n`status`, `job` and `error` are private: [`Envelope::new`] and the [`Outcome`] enum are the\nonly way to populate them, which is what makes the cross-field rule a type-level fact rather\nthan a convention.",
  "properties": {
    "artifacts": {
      "description": "Bounded artifacts available for reading.",
      "items": {
        "$ref": "#/$defs/ArtifactHandle"
      },
      "type": "array"
    },
    "context_id": {
      "description": "The research context, or `null`.",
      "type": [
        "string",
