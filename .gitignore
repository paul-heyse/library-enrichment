# Rust
/target/
**/*.rs.bk

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Service state during development.
# Production resolves to XDG paths (~/.cache/library-enrichment,
# ~/.local/share/library-enrichment). Agent sessions are redirected here by
# scripts/hooks/session_env.sh so development never mutates real user state.
/.dev-state/

# Service-owned capsules (blueprint §9.1). Never committed.
/capsules/*
!/capsules/README.md

# Generated reports and logs
/docs/reports/*.json
/docs/reports/logs/
!/docs/reports/.gitkeep

# Personal, per-machine overrides
CLAUDE.local.md
/.claude/settings.local.json
.envrc.local

# Editor / OS
.DS_Store
*.swp
