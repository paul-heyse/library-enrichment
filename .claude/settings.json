{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "BASH_MAX_OUTPUT_LENGTH": "60000",
    "CARGO_TERM_COLOR": "never",
    "RUST_BACKTRACE": "1"
  },
  "enabledPlugins": {
    "pyrefly-local@local-pyrefly-tools": false,
    "pyright-lsp@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo metadata*)",
      "Bash(cargo tree*)",
      "Bash(cargo nextest run*)",
      "Bash(cargo test --doc*)",
      "Bash(cargo deny check*)",
      "Bash(cargo hack*)",
      "Bash(cargo machete*)",
      "Bash(cargo udeps*)",
      "Bash(cargo semver-checks*)",
      "Bash(cargo llvm-cov*)",
      "Bash(cargo insta*)",
      "Bash(cargo doc*)",
      "Bash(cargo +1.98.1 *)",
      "Bash(rustup check*)",
      "Bash(rustup toolchain install*)",
      "Bash(cargo +nightly-2026-09-13 *)",
      "Bash(cargo +nightly-2026-08-18 *)",
      "Bash(cargo +nightly-2026-07-15 *)",
      "Bash(cargo +nightly-2026-05-23 *)",
      "Bash(cargo +nightly-2026-02-28 *)",
      "Bash(rustc --version*)",
      "Bash(rustc -vV*)",
      "Bash(rustup show*)",
      "Bash(rustup toolchain list*)",
      "Bash(rustfmt *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(uv python*)",
      "Bash(uv tree*)",
      "Bash(uv venv*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run ty *)",
      "Bash(uv run python*)",
      "Bash(uv run griffe*)",
      "Bash(ty check*)",
      "Bash(ty server*)",
      "Bash(ty version*)",
      "Bash(ty --version*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(ruff --version*)",
      "Bash(pytest*)",
      "Bash(griffe *)",
      "Bash(library-enrichmentd *)",
      "Bash(library-enrichment-mcp*)",
      "Bash(library-enrichment-worker*)",
      "Bash(direnv allow*)",
      "Bash(direnv exec *)",
      "Bash(direnv status*)",
      "Bash(direnv reload*)",
      "Bash(sccache --show-stats*)",
      "Bash(ast-grep scan*)",
      "Bash(ast-grep test*)",
      "Bash(sg scan*)",
      "Bash(sg test*)",
      "Bash(taplo fmt*)",
      "Bash(taplo check*)",
      "Bash(typos*)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sha256sum *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git restore*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(podman run --rm*)",
      "Bash(podman image*)",
      "Bash(bwrap *)",
      "Bash(./scripts/*)",
      "Bash(bash scripts/*)",
      "Read(//home/paul/library-enrichment/**)",
      "WebFetch(domain:gofastmcp.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:mkdocstrings.github.io)",
      "WebFetch(domain:docs.pypi.org)",
      "WebFetch(domain:packaging.python.org)",
      "WebFetch(domain:typing.python.org)",
      "WebFetch(domain:rust-analyzer.github.io)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:pypi.org)"
    ],
    "deny": [
      "Bash(pyrefly*)",
      "Bash(uv run pyrefly*)",
      "Bash(uv tool run pyrefly*)",
      "Bash(pyright*)",
      "Bash(uv run pyright*)",
      "Bash(basedpyright*)",
      "Bash(mypy*)",
      "Bash(uv run mypy*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(cargo publish*)",
      "Bash(uv publish*)",
      "Bash(maturin publish*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//home/paul/.ssh/**)",
      "Read(//home/paul/.aws/**)",
      "Read(//home/paul/.config/gh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/session_env.sh",
            "timeout": 10,
            "statusMessage": "Isolating service state"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/session_start.sh",
            "timeout": 20,
            "statusMessage": "Loading library-enrichment environment"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/session_env.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/pre_bash.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/pre_edit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/post_edit.sh",
            "timeout": 60,
            "statusMessage": "Formatting and rule-scanning"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/stop_guard.sh",
            "timeout": 30,
            "statusMessage": "Checking gate claims"
          }
        ]
      }
    ]
  }
}
