        "-oP",
        "said \"hello\"",
        "docs/quotes.txt"
      ],
      "control_expect": "said \"hello\"",
      "control_mode": "differs",
      "note": "Here the control must SUCCEED but differ: it proves \\K changed the span, not the match set.",
      "since_pcre2": ""
    },
    {
      "id": "P008",
