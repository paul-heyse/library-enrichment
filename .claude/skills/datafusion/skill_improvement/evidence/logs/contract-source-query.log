atch(\n        &self,\n        record_batch: &RecordBatch,\n    ) -> Result<RecordBatch, ArrowError> {\n        let filtered_arrays = record_batch\n            .columns()\n            .iter()\n            .map(|a| filter_array(a, self))\n            .collect::<Result<Vec<_>, _>>()?;\n\n        // SAFETY: we know that the set of filtered arrays will match the schema of the original\n        // record batch\n        unsafe {\n            Ok(RecordBatch::new_unchecked(\n                record_batch.schema(),\n                filtered_arrays,\n                self.count,\n            ))\n        }\n    }","range":{"byteOffset":{"start":15109,"end":15719},"start":{"line":444,"column":4},"end":{"line":463,"column":5}},"file":"sources/arrow-select-59.3.0/src/filter.rs","lines":"    pub fn filter_record_batch(\n        &self,\n        record_batch: &RecordBatch,\n    ) -> Result<RecordBatch, ArrowError> {\n        let filtered_arrays = record_batch\n            .columns()\n            .iter()\n            .map(|a| filter_array(a, self))\n            .collect::<Result<Vec<_>, _>>()?;\n\n        // SAFETY: we know that the set of filtered arrays will match the schema of the original\n        // record batch\n        unsafe {\n            Ok(RecordBatch::new_unchecked(\n                record_batch.schema(),\n                filtered_arrays,\n                self.count,\n            ))\n        }\n    }","charCount":{"leading":4,"trailing":0},"language":"Rust","metaVariables":{"single":{},"multi":{"secondary":[{"text":"filter_record_batch","range":{"byteOffset":{"start":15116,"end":15135},"start":{"line":444,"column":11},"end":{"line":444,"column":30}}}]},"transformed":{}},"ruleId":"contract-entrypoints","severity":"hint","note":null,"message":"Candidate contract entry point; inspect documentation and body before inferring behavior.","labels":[{"text":"pub fn filter_record_batch(\n        &self,\n        record_batch: &RecordBatch,\n    ) -> Result<RecordBatch, ArrowError> {\n