        },
        {
          "name": "has_nonlocal_binding",
          "signature": "fn has_nonlocal_binding(&self, name: &str) -> bool",
          "summary": "Returns `true` if `name` has a binding in an enclosing scope."
        },
        {
          "name": "in_async_context",
          "signature": "fn in_async_context(&self) -> bool",
          "summary": "Returns `true` if the visitor is currently in an async context, i.e. an async function."
        },
        {
          "name": "in_await_allowed_context",
          "signature": "fn in_await_allowed_context(&self) -> bool",
          "summary": "Returns `true` if the visitor is currently in a context where the `await` keyword is allowed."
        },
        {
          "name": "in_class_body_comprehension",
          "signature": "fn in_class_body_comprehension(&self) -> bool",
          "summary": "Returns `true` if a comprehension introduced at the current position is nested directly or indirectly in a class body, without crossing a function or lambda boundary."
        },
        {
          "name": "in_function_scope",
          "signature": "fn in_function_scope(&self) -> bool",
          "summary": "Returns `true` if the visitor is in a function scope."
        },
        {
          "name": "in_generator_context",
          "signature": "fn in_generator_context(&self) -> bool",
          "summary": "Returns `true` if the visitor is within a generator scope."
        },
        {
          "name": "in_loop_context",
          "signature": "fn in_loop_context(&self) -> bool",
          "summary": "Returns `true` if the visitor is inside a `for` or `while` loop."
        },
        {
          "name": "in_module_scope",
          "signature": "fn in_module_scope(&self) -> bool",
          "summary": "Returns `true` if the visitor is at the top-level module scope."
        },
        {
          "name": "in_notebook",
          "signature": "fn in_notebook(&self) -> bool",
          "summary": "Returns `true` if the source file is a Jupyter notebook."
        },
        {
          "name": "in_sync_comprehension",
          "signature": "fn in_sync_comprehension(&self) -> bool",
          "summary": "Returns `true` if the visitor is currently inside of a synchronous comprehension."
        },
        {
          "name": "in_yield_allowed_context",
          "signature": "fn in_yield_allowed_context(&self) -> bool",
          "summary": "Returns `true` if the visitor is currently in a context where `yield` and `yield from` expressions are allowed."
        },
        {
          "name": "is_bound_parameter",
          "signature": "fn is_bound_parameter(&self, name: &str) -> bool",
          "summary": "Returns `true` if `name` is a bound parameter in the current function or lambda scope."
        },
        {
          "name": "lazy_import_context",
          "signature": "fn lazy_import_context(&self) -> Option<LazyImportContext>",
          "summary": "Returns the nearest invalid context for a `lazy` import statement, if any."
        },
        {
          "name": "python_version",
          "signature": "fn python_version(&self) -> PythonVersion",
          "summary": "The target Python version for detecting backwards-incompatible syntax changes."
        },
