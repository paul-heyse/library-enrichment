   "preferred": "typer._completion_shared.COMPLETION_SCRIPT_ZSH",
   "signature": "COMPLETION_SCRIPT_ZSH = '\\n#compdef %(prog_name)s\\n\\n%(complete_func)s() {\\n  eval $(env _TYPER_COMPLETE_ARGS=\"${words[1,$CURRENT]}\" %(autocomplete_var)s=complete_zsh %(prog_name)s)\\n}\\n\\ncompdef %(complete_func)s %(prog_name)s\\n'",
   "summary": ""
  },
