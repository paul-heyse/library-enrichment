{
  "_comment": [
    "Structural extract of contracts/research-envelope.schema.json, the frozen Phase-0",
    "acceptance target. Generated schemas need not match that file byte-for-byte ($id,",
    "$defs ordering and serde-derived naming will legitimately differ) but MUST agree on",
    "every value below. An agent that silently drops INVALID_CURSOR or renames",
    "compatible_claimed fails a gate rather than a diff review.",
    "Regenerate only via an ADR that re-freezes the bundle."
  ],
  "root_required": [
    "artifacts",
    "context_id",
    "coverage",
    "data",
    "error",
    "evidence",
    "freshness",
    "job",
    "pagination",
    "request_id",
    "schema_version",
    "snapshot_id",
    "status",
    "summary"
  ],
  "root_additional_properties": false,
  "schema_version_const": "1.0",
  "status": [
    "ok",
    "partial",
    "pending",
    "error"
  ],
  "error_codes": [
    "VERSION_NOT_FOUND",
    "AMBIGUOUS_PACKAGE",
    "ARTIFACT_UNAVAILABLE",
    "UNSUPPORTED_FORMAT",
    "ENVIRONMENT_UNRESOLVED",
    "ENVIRONMENT_MISMATCH",
    "POLICY_DENIED",
    "UNSUPPORTED_CAPABILITY",
    "UPSTREAM_UNAVAILABLE",
    "EXTRACTION_FAILED",
    "VERIFICATION_FAILED",
    "BUDGET_EXCEEDED",
    "INVALID_CURSOR"
  ],
  "evidence_class": [
    "declared",
    "statically_extracted",
    "compiler_derived",
    "typechecker_observed",
    "runtime_observed",
    "agent_inferred"
  ],
  "source_version_match": [
    "exact",
    "compatible_claimed",
    "mismatched",
    "unknown"
  ],
  "job_state": [
    "queued",
    "running",
    "succeeded",
    "partial",
    "failed",
    "cancel_requested",
    "cancelled"
  ],
  "artifact_uri_pattern": "^library-evidence://",
  "coverage_required": [
    "indexed",
    "limitations",
    "missing",
    "scope"
  ],
  "evidence_required": [
    "artifact_id",
    "evidence_class",
    "evidence_id",
    "excerpt",
    "locator",
    "producer",
    "producer_version",
    "source_uri",
    "source_version_match",
    "subject"
  ],
  "pagination_required": [
    "next_cursor",
    "returned",
    "total_matches",
    "truncated"
  ],
  "job_required": [
    "job_id",
    "poll_after_ms",
    "stage",
    "state"
  ],
  "error_required": [
    "code",
    "message",
    "next_action",
    "retryable"
  ]
}
