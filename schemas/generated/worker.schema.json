          "uniqueItems": true
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/PythonParameter"
          },
          "type": "array"
        },
        "returns": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "parameters",
        "returns",
        "labels"
      ],
      "type": "object"
    },
    "PythonDefaultOrigin": {
      "description": "Native interpretation of Griffe's reported value and parameter kind.",
      "enum": [
        "absent",
        "declared",
        "implicit_variadic"
      ],
      "type": "string"
    },
    "PythonOverload": {
      "additionalProperties": false,
      "properties": {
