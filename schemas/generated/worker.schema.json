        "signature": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind",
        "origin",
        "file",
        "line",
        "signature",
        "callable",
        "overload_ordinal",
        "overloads",
        "docs",
        "alias_target",
        "bases",
        "publicness"
      ],
      "type": "object"
    },
    "ObservationOrigin": {
      "description": "A source or stub annotation is not a runtime observation.",
      "enum": [
        "source",
        "stub"
      ],
      "type": "string"
    },
    "Publicness": {
      "additionalProperties": false,
      "description": "Independent signals; no one signal is a publicness verdict.",
      "properties": {
        "declared_exports": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "docstring": {
          "type": "boolean"
        },
        "exported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reexport": {
          "type": "boolean"
        },
        "underscore": {
          "type": "boolean"
        },
        "unresolved_exports": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "exported",
        "underscore",
        "reexport",
        "docstring",
        "declared_exports",
        "unresolved_exports"
      ],
      "type": "object"
    },
    "PythonBase": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
