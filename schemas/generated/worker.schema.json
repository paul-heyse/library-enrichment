          "type": [
            "string",
            "null"
          ]
        },
        "bases": {
          "items": {
            "$ref": "#/$defs/PythonBase"
          },
          "type": "array"
        },
        "callable": {
          "anyOf": [
            {
              "$ref": "#/$defs/PythonCallable"
            },
            {
              "type": "null"
            }
          ]
        },
        "docs": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/ObservationOrigin"
        },
        "overload_ordinal": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "overloads": {
          "items": {
            "$ref": "#/$defs/PythonOverload"
