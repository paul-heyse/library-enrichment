    "PythonParameter": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/PythonDefaultOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/PythonParameterKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "ordinal": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reported_default": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ordinal",
        "name",
        "kind",
        "annotation",
        "reported_default",
        "default_origin"
      ],
      "type": "object"
    },
    "PythonParameterKind": {
      "enum": [
        "positional-only",
        "positional or keyword",
        "variadic positional",
        "keyword-only",
        "variadic keyword"
      ],
      "type": "string"
    },
    "WorkerFile": {
      "additionalProperties": false,
      "description": "One source file selected by Rust for the static worker.",
      "properties": {
        "file": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/ObservationOrigin"
        }
      },
      "required": [
        "file",
        "module",
        "origin"
      ],
      "type": "object"
    },
    "WorkerRequest": {
      "additionalProperties": false,
      "description": "Rust-owned bounded request for the separate extraction worker.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/WorkerFile"
          },
          "maxItems": 65536,
          "minItems": 0,
          "type": "array"
        },
        "max_cpu_seconds": {
          "format": "decimal-uint64",
          "pattern": "^(?:1(?:0[0-9]{18}|[1-7][0-9]{18}|8(?:0[0-9]{17}|[1-3][0-9]{17}|4(?:0[0-9]{16}|[1-3][0-9]{16}|4(?:0[0-9]{15}|[1-5][0-9]{15}|6(?:0[0-9]{14}|[1-6][0-9]{14}|7(?:0[0-9]{13}|[1-3][0-9]{13}|4(?:0[0-9]{12}|[1-3][0-9]{12}|40(?:0[0-9]{10}|[1-6][0-9]{10}|7(?:0[0-9]{9}|[1-2][0-9]{9}|3(?:0[0-9]{8}|[1-6][0-9]{8}|70(?:0[0-9]{6}|[1-8][0-9]{6}|9(?:0[0-9]{5}|[1-4][0-9]{5}|5(?:0[0-9]{4}|[1-4][0-9]{4}|5(?:0[0-9]{3}|1(?:0[0-9]{2}|[1-5][0-9]{2}|6(?:0[0-9]{1}|1[0-5][0-9]{0}))))))))))))))))|[1-9][0-9]{0,18})$",
          "type": "string"
        },
        "max_memory_bytes": {
          "format": "decimal-uint64",
          "pattern": "^(?:1(?:0[0-9]{18}|[1-7][0-9]{18}|8(?:0[0-9]{17}|[1-3][0-9]{17}|4(?:0[0-9]{16}|[1-3][0-9]{16}|4(?:0[0-9]{15}|[1-5][0-9]{15}|6(?:0[0-9]{14}|[1-6][0-9]{14}|7(?:0[0-9]{13}|[1-3][0-9]{13}|4(?:0[0-9]{12}|[1-3][0-9]{12}|40(?:0[0-9]{10}|[1-6][0-9]{10}|7(?:0[0-9]{9}|[1-2][0-9]{9}|3(?:0[0-9]{8}|[1-6][0-9]{8}|70(?:0[0-9]{6}|[1-8][0-9]{6}|9(?:0[0-9]{5}|[1-4][0-9]{5}|5(?:0[0-9]{4}|[1-4][0-9]{4}|5(?:0[0-9]{3}|1(?:0[0-9]{2}|[1-5][0-9]{2}|6(?:0[0-9]{1}|1[0-5][0-9]{0}))))))))))))))))|[1-9][0-9]{0,18})$",
          "type": "string"
        },
        "max_observations": {
          "format": "decimal-uint64",
          "pattern": "^(?:100000|[1-9][0-9]{0,4})$",
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "root",
        "files",
        "max_observations",
        "max_memory_bytes",
        "max_cpu_seconds"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Generated request and mechanical observation DTOs; output is the Arrow fact stream.",
  "properties": {
    "observation": {
      "$ref": "#/$defs/Observation",
      "description": "The mechanical observation encoded under the generated Arrow schema."
    },
    "request": {
      "$ref": "#/$defs/WorkerRequest",
      "description": "Input."
    }
  },
  "required": [
    "request",
    "observation"
  ],
  "title": "WorkerProtocol",
  "type": "object"
}
